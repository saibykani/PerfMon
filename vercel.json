{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://powerful-helpful-sec-approx.trycloudflare.com/api/:path*"
    },
    {
      "source": "/report-content/:path*",
      "destination": "https://powerful-helpful-sec-approx.trycloudflare.com/report-content/:path*"
    },
    {
      "source": "/((?!assets/|brand/|docs/|samples/|favicon|logo.svg|apple-touch-icon|icon-512).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
