# ---- Server ----
PORT=8080
# Second listener that serves uploaded HTML reports from a separate origin (sandbox).
REPORT_CONTENT_PORT=8081
REPORT_CONTENT_ORIGIN=http://localhost:8081
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# ---- Data stores ----
DATABASE_URL=postgres://perfmon:perfmon@localhost:5433/perfmon
# Optional dedicated time-series Postgres (TimescaleDB-compatible). Defaults to DATABASE_URL.
TIMESERIES_DB_URL=
REDIS_URL=redis://localhost:6380

# ---- Artifact storage: local | s3 | azure ----
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage-data
OBJECT_STORAGE_URL=http://localhost:9000
OBJECT_STORAGE_BUCKET=perfmon
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=perfmon
OBJECT_STORAGE_SECRET_KEY=perfmon-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=perfmon

# ---- Security (never commit real values) ----
JWT_SECRET=change-me-dev-only-jwt-secret-please-override
JWT_EXPIRES_IN=12h
ENCRYPTION_KEY=change-me-dev-only-encryption-key-32b
MAX_UPLOAD_MB=512
INGEST_RATE_LIMIT_PER_SEC=100
API_RATE_LIMIT_PER_MIN=1200
# Optional malware-scan hook: HTTP endpoint receiving {sha256, filename, size}; must reply {clean:boolean}
MALWARE_SCAN_URL=

# ---- Ingestion ----
INGEST_FLUSH_INTERVAL_MS=1000
INGEST_MAX_BUFFER=50000
WORKER_CONCURRENCY=4
ENABLE_WORKER=true

# ---- Integrations (optional defaults) ----
INFLUXDB_URL=
PROMETHEUS_URL=
DYNATRACE_URL=

# ---- Email (optional; alerts + password reset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=perfmon@localhost

# ---- Demo data ----
SEED_DEMO_DATA=true
# Shows the demo login on the sign-in page — local demos only, never in shared environments
SHOW_DEMO_CREDENTIALS=true
DEMO_ADMIN_EMAIL=admin@perfmon.local
DEMO_ADMIN_PASSWORD=Perfmon@123
