{
  "name": "@perfmon/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed/seed-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@azure/storage-blob": "^12.26.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.0",
    "pdfkit": "^0.17.0",
    "pg": "^8.13.0",
    "pino-pretty": "^13.0.0",
    "systeminformation": "^5.33.15",
    "undici": "^7.30.0",
    "yauzl": "^3.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/yauzl": "^2.10.3",
    "openapi-types": "^12.1.3",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
